{
  "name": "exponential-cli",
  "version": "1.11.0",
  "description": "CLI to interact with Exponential productivity app - pull actions for LLM consumption",
  "type": "module",
  "bin": {
    "exponential": "bin/exponential.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "productivity",
    "actions",
    "tasks",
    "exponential"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "exponential-sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
